/*
The purpose of this program is to reverse the order of elements
 within an array in-place using the Two-Pointer technique.
  Instead of allocating extra memory for a new array, it efficiently
  swaps elements from both ends moving toward the center, optimizing
  space complexity to O(1)
 */



public class ArrayReversal {
    public static void main(String[] args) {
        //input dataset (an array of IDs or numbers)
        int[] dataSet = {10,20,30,40,50,60};
        System.out.println("Original Array: " + java.util.Arrays.toString(dataSet));

        //two-pointer algorithm setup
        int left = 0; //index 0
        int right = dataSet.length-1; //index 5 !!!

        //loop until pointers meet in the middle
        while (left < right) {
            //temporary storage to prevent data loss
            int temp = dataSet[left];

            //assign the valute at right to the left index
            dataSet[left] = dataSet[right];

            //assign temp value to the right index
            dataSet[right] = temp;

            //move pointers closer to the center
            left++;
            right--;
        }
        System.out.println("Reversed Array: " + java.util.Arrays.toString(dataSet));

    }
}
